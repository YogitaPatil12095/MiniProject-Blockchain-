MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/intellihealth?retryWrites=true&w=majority
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000
# ADMIN_ADDRESS must be set to your deployer wallet address (the address used in hardhat deploy).
# Without this, GET /api/audit/logs will always return 403.
ADMIN_ADDRESS=0xYourDeployerWalletAddressHere
